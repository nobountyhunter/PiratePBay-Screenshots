{
  "manifest_version": 3,
  "name": "ThePBay Screenshots",
  "version": "1.1.0",
  "description": "Shows screenshot links from descriptions inline, without opening each link.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Inline Screenshot Expander"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://thepiratebay.org/description.php*",
        "*://*.thepiratebay.org/description.php*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
